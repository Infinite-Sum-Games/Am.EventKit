meta {
  name: getEventbyId
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/events/:eventId
  body: json
  auth: inherit
}

params:path {
  eventId: 3bf7ee89-ba2a-4ca4-9a35-962042238d9b
}

