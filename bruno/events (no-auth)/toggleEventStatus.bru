docs {
  # Toggle event status
  
    - Method: `PUT`
    - URL: `/api/v1/events/:eventId/toggle-status`
    - Path params:
      - `eventId` – UUID of the event whose status should be toggled
  
    ## 200 OK
    ```json
    {
      "message": "Event status toggled successfully"
    }
    ```
  
    ## 400 Bad Request
    ```json
    {
      "message": "Request is malformed"
    }
    ```
  
    ## 401 Unauthorized
    ```json
    {
      "message": "Access denied."
    }
    ```
  
    ## 404 Not Found
    ```json
    {
      "message": "Event does not exist"
    }
    ```
  
    ## 500 Internal Server Error
    ```json
    {
      "message": "Oops! Something happened. Please try again later"
    }
    ```
  }
}
