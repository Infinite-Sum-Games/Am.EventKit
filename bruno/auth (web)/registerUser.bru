meta {
  name: registerUser
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/user/register
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Ritesh Koushik",
    "email": "riteshkoushik39@gmail.com",
    "password": "password123",
    "phone_number": "9994622650",
    "is_amrita_student": true,
    "amrita_roll_number": "CB.EN.U4CSE22253",
    "college_name": "Amrita Vishwa Vidyapeetham",
    "college_city": "Coimbatore"
  }
  
}

script:pre-request {
  const jar = bru.cookies.jar();
  
  const path = bru.getEnvName("baseUrl") + "/auth/user/register";
  const cookieValue = await jar.getCookie(path, "csrf_token");
  
  req.setHeader("X-Csrf-Token", cookieValue);
}

docs {
  # Register User
  
  > Make sure to get the CSRF token for this route before sending this request. Else it will lead to 401. Make sure to set it as "X-Csrf-Token".
  
  ## 200 OK
  ```json
  {
    "message": "User onboarding initiated. OTP sent to email.",
    "expiry_at": ""
  }
  ```
  
  ## 401 Unauthorized
  The CSRF token is either not passed in header or cookie or both.
  ```json
  {
    "message": "Access denied.",
  }
  ```
  
  ## 403 Forbidden
  The CSRF token is not parsable. This can be due to some tampering with the CSRF cookie. 
  ```json
  {
    "message": "User is forbidden",
  }
  ```
  
  ## 500 Internal Server Error
  Check the log file and inform backend team about the error immediately.
  ```json
  {
    "message": "Oops! Something happened. Please try again later."
  }
  ```
}
