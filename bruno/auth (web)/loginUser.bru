meta {
  name: loginUser
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/login
  body: none
  auth: inherit
}

script:pre-request {
  const jar = bru.cookies.jar();
  
  const path = bru.getEnvName("baseUrl") + "/auth/login";
  const cookieValue = await jar.getCookie(path, "csrf_token");
  
  req.setHeader("X-Csrf-Token", cookieValue.value);
}

settings {
  encodeUrl: true
  timeout: 0
}
