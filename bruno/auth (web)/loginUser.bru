meta {
  name: loginUser
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/user/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "cb.en.u4cse22538@cb.students.amrita.edu",
    "password": "password123"
  }
}

script:pre-request {
  const jar = bru.cookies.jar();
  
  const path = bru.getEnvVar("baseUrl") + "/auth/user/login";
  console.log(path);
  
  const cookieValue = await jar.getCookie(path, "csrf_token");
  console.log(cookieValue);
  
  req.setHeader("X-Csrf-Token", cookieValue.value);
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # Login User
  > Remember to fetch the CSRF token first before proceeding with the request
  
  ## 200 OK
  ```json
  {
    "email": "cb.en.u4cse22038@cb.students.amrita.edu",
    "message": "User logged in successfully",
    "name": "Ritesh Koushik"
  }
  ```
  
  ## 401 Unauthorized
  Missing CSRF token
  ```json
  {
    "message": "Access denied."
  }
  ```
  
  ## 404 Not Found
  Either email or password is wrong, the same error will be shown
  ```json
  {
    "message": "Invalid credentials"
  }
  ```
  
  ## 500 Internal Server Error
  ```json
  {
    "message": "Oops! Something happened. Please try again later."
  }
  ```
}
