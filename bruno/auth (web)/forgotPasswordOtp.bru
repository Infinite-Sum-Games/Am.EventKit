meta {
  name: forgotPasswordOtp
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/auth/user/forgot-password/otp/verify
  body: none
  auth: inherit
}

script:pre-request {
  const jar = bru.cookies.jar();
  
  const path = bru.getEnvName("baseUrl") + "/auth/user/forgot-password/otp/verify";
  const cookieValue = await jar.getCookie(path, "csrf_token");
  
  req.setHeader("X-Csrf-Token", cookieValue);
}

settings {
  encodeUrl: true
  timeout: 0
}
