meta {
  name: userOtpResend
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/auth/user/register/otp/resend
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # OTP Resend
  
  ## 200 OK
  ```json
  {
    "message": "OTP resent to user email successfully",
    "expiry_at": ""
  }
  ```
  
  ## 401 Unauthorized
  This arises due to missing temporary token. A temporary token is setup to control the duration allowed for filling out the OTP form. Without this, an endless request of CSRF requests and OTP requests would be made.
  ```json
  {
    "message": "Access denied."
  }
  ```
  
  ## 500 Internal Server Error
  ```json
  {
    "message": "Oops! Something happened. Please try again later."
  }
  ```
  
}
