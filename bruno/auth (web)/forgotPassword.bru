meta {
  name: forgotPassword
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/auth/user/forgot-password
  body: json
  auth: inherit
}

body:json {
  {
    "email": "cb.en.u4cse22038@cb.students.amrita.edu",
    "new_password": "new-password-hash"
  }
}

script:pre-request {
  const jar = bru.cookies.jar();
  
  const path = bru.getEnvVar("baseUrl") + "/auth/user/forgot-password";
  console.log(path);
  
  const cookieValue = await jar.getCookie(path, "csrf_token");
  console.log(cookieValue);
  
  req.setHeader("X-Csrf-Token", cookieValue.value);
}

settings {
  encodeUrl: true
  timeout: 0
}
