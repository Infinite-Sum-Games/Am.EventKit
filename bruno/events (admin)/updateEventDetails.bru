meta {
  name: updateEventDetails
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/events/admin/details/:eventId
  body: json
  auth: inherit
}

params:path {
  eventId: 209b2213-a90c-4afb-915b-58e1b077f988
}

body:json {
  {
    "name": "AI Hackathon - Updated",
    "blurb": "Updated blurb for the AI hackathon",
    "description": "Updated description for the 24-hour AI hackathon.",
    "poster_url": "https://example.com/images/ai-hackathon-updated.png",
    "price": 150.0,
    "rules": "No plagiarism. Teams must submit code on GitHub. Updated rules apply."
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # Edit an existing event
  
    - Path params:
      - `eventId` – UUID of the event to update
  
    ## Request Body
  
    ```json
    {
      "name": "AI Hackathon - Updated",
      "blurb": "Updated blurb for the AI hackathon",
      "description": "Updated description for the 24-hour AI hackathon.",
      "cover_image_url": "https://example.com/images/ai-hackathon-updated.png",
      "price": 150.0,
      "is_per_head": true,
      "rules": "No plagiarism. Teams must submit code on GitHub. Updated rules apply.",
      "event_type": "EVENT",
      "is_group": true,
      "max_teamsize": 5,
      "min_teamsize": 2,
      "total_seats": 120,
      "seats_filled": 10,
      "event_status": "ACTIVE",
      "event_mode": "OFFLINE",
      "attendance_mode": "SOLO",
      "organizer_ids": [
        "005611c4-21dc-43dc-a5f1-4b6132744d01"
      ],
      "tag_ids": [
        "31725984-44a0-45c1-bd68-5ba2c22c7648"
      ],
      "people_ids": [
        "65c77c3a-c359-4dc6-a7f6-f7a1a7f07645"
      ],
      "schedules": [
        {
          "event_date": "2025-11-29",
          "start_time": "11:00:00",
          "end_time": "13:00:00",
          "venue": "Main Auditorium"
        },
        {
          "event_date": "2025-11-30",
          "start_time": "15:00:00",
          "end_time": "17:00:00",
          "venue": "Lab 102"
        }
      ]
    }
    ```
  
    ## 200 OK
    ```json
    {
      "message": "Event updated successfully"
    }
    ```
  
    ## 400 Bad Request
    ```json
    {
      "message": "Request is malformed"
    }
    ```
    
    ## 403 Forbidden
    ```json
    {
      "message": "Permission denied"
    }
    ```
  
    ## 404 Not Found
    ```json
    {
      "message": "Event does not exist"
    }
    ```
  
    ## 500 Internal Server Error
    ```json
    {
      "message": "Oops! Something happened. Please try again later"
    }
    ```
  
}
