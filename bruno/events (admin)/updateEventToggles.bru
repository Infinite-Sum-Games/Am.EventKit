meta {
  name: updateEventToggles
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/events/admin/toggle/:eventId
  body: json
  auth: inherit
}

params:path {
  eventId: 9ae761e9-a4e3-4792-adc3-8f8286e92caa
}

body:json {
  {
    "event_type": "WORKSHOP",
    "attendance_mode": "SOLO",
    "is_offline": true,
    "is_technical": true
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
