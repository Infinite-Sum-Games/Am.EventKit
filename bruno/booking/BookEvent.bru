meta {
  name: BookEvent
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/events/:eventId/book
  body: json
  auth: inherit
}

params:path {
  eventId: 
}

body:json {
  // Use this body ONLY when registering for TEAM events.
  // For SOLO events, do NOT send a request body.
  
  {
    "team_name": "Byte Benders",
    "team_members": [
      {
        "student_email": "john.team1@example.com",
        "student_role": "Developer"
      },
      {
        "student_email": "mary.team1@example.com",
        "student_role": "Designer"
      }
    ],
  
    // OPTIONAL
    // Allowed values: "agentic_ai" | "generative_ai" | "aiot"
    // If not applicable, omit this field entirely
    "ps": "agentic_ai"
  }
  
}

settings {
  encodeUrl: true
  timeout: 0
}
