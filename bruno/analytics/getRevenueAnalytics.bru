meta {
  name: GetRevenueAnalytics
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/analytics/revenue
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # Revenue Analytics

  Fetches revenue analytics including:
  - Total revenue
  - Revenue grouped by event
  - Revenue grouped by date
  - Revenue grouped by organizer

  ## 200 OK
  ```json
  {
    "message": "Successfully fetched revenue analytics",
    "revenue_summary": {
      "total_revenue": 0,
      "revenue_per_event": [],
      "revenue_per_date": [],
      "revenue_per_organizer": []
    }
  }
  ```

  ## 401 Unauthorized
  Missing auth or refresh token
  ```json
  {
    "message": "Access denied."
  }
  ```

  ## 500 Internal Server Error
  ```json
  {
    "message": "Oops! Something happened. Please try again later"
  }
  ```
}